LIULIANGCHUHAI_LLM_PROVIDER=mock
LIULIANGCHUHAI_ASSISTANT_PROVIDER=mock
LIULIANGCHUHAI_DEEPSEEK_API_KEY=
LIULIANGCHUHAI_DEEPSEEK_MODEL=deepseek-v4-flash
LIULIANGCHUHAI_DEEPSEEK_TIMEOUT_SECONDS=20
LIULIANGCHUHAI_CONTENT_PLAN_TIMEOUT_SECONDS=60
LIULIANGCHUHAI_DIGITAL_HUMAN_PROVIDER=local
LIULIANGCHUHAI_HEYGEN_API_KEY=
LIULIANGCHUHAI_HEYGEN_AVATAR_ID=
LIULIANGCHUHAI_HEYGEN_VOICE_ID=
# Alibaba Cloud Bailian `videoretalk` (personal real-name account, no company).
# SOURCE_VIDEO_URL is your own clip, reachable by Alibaba; record it once and reuse.
LIULIANGCHUHAI_DASHSCOPE_API_KEY=
LIULIANGCHUHAI_DASHSCOPE_SOURCE_VIDEO_URL=
LIULIANGCHUHAI_DIGITAL_HUMAN_TIMEOUT_SECONDS=300
# Key visuals. `drawn` needs nothing; `openai` talks to OpenAI or to any relay
# that serves /images/generations, which is why BASE_URL is configurable.
LIULIANGCHUHAI_IMAGE_PROVIDER=drawn
LIULIANGCHUHAI_IMAGE_BASE_URL=https://api.openai.com/v1
LIULIANGCHUHAI_IMAGE_API_KEY=
LIULIANGCHUHAI_IMAGE_MODEL=gpt-image-1
LIULIANGCHUHAI_IMAGE_SIZE=1024x1536
LIULIANGCHUHAI_IMAGE_TIMEOUT_SECONDS=120
# Ark-compatible video tasks: Seedance 2.5 and similar. Point BASE_URL at
# Volcengine Ark, or at a relay that serves /api/v3/contents/generations/tasks.
# A relay key must come from its video group; a chat/image-group token is
# refused with "not enabled for this group". Switch the provider with the
# fully prefixed name below.
# LIULIANGCHUHAI_VIDEO_PROVIDER=ark
LIULIANGCHUHAI_ARK_VIDEO_BASE_URL=https://ark.cn-beijing.volces.com
LIULIANGCHUHAI_ARK_VIDEO_API_KEY=
LIULIANGCHUHAI_ARK_VIDEO_MODEL=seedance2.5-A
LIULIANGCHUHAI_ARK_VIDEO_RESOLUTION=480P
LIULIANGCHUHAI_ARK_VIDEO_DURATION_SECONDS=5
LIULIANGCHUHAI_ARK_VIDEO_RATIO=9:16
# Leave commented to use the model's default; false keeps the clip silent.
# LIULIANGCHUHAI_ARK_VIDEO_GENERATE_AUDIO=false
# LIULIANGCHUHAI_ARK_VIDEO_WATERMARK=false
LIULIANGCHUHAI_CORS_ORIGINS='["http://localhost:3000"]'
LIULIANGCHUHAI_MEDIA_DIR=media
LIULIANGCHUHAI_MEDIA_URL_PREFIX=/media
LIULIANGCHUHAI_PRODUCT_SOURCE=off
LIULIANGCHUHAI_PRODUCT_SOURCE_TIMEOUT_SECONDS=8
