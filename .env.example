# 应用配置 | Application Configuration
NEXT_PUBLIC_APP_NAME="Guangxi-ASEAN Cultural Exhibition"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=zh

# API 配置 | API Configuration
NEXT_PUBLIC_API_URL=http://localhost:1337/api
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:1337/graphql

# Strapi CMS
STRAPI_API_URL=http://localhost:1337
STRAPI_API_TOKEN=your_strapi_api_token_here

# 数据库 | Database
DATABASE_URL=postgresql://user:password@localhost:5432/guangxi_asean_db

# Redis
REDIS_URL=redis://localhost:6379

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your_elasticsearch_password

# 对象存储 | Object Storage
# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=guangxi-asean-assets

# 或使用阿里云 OSS | Or use Aliyun OSS
ALIYUN_OSS_ACCESS_KEY_ID=your_aliyun_access_key
ALIYUN_OSS_ACCESS_KEY_SECRET=your_aliyun_secret_key
ALIYUN_OSS_REGION=oss-cn-hangzhou
ALIYUN_OSS_BUCKET=guangxi-asean-assets

# CDN
NEXT_PUBLIC_CDN_URL=https://cdn.example.com

# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# 图像优化 | Image Optimization
NEXT_PUBLIC_IMAGEKIT_ID=your_imagekit_id
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key

# 地图服务 | Map Service
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token

# 认证 | Authentication (Optional)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here
GITHUB_ID=your_github_oauth_id
GITHUB_SECRET=your_github_oauth_secret
GOOGLE_ID=your_google_oauth_id
GOOGLE_SECRET=your_google_oauth_secret

# 功能开关 | Feature Flags
NEXT_PUBLIC_ENABLE_3D=true
NEXT_PUBLIC_ENABLE_AR=true
NEXT_PUBLIC_ENABLE_VR=false
NEXT_PUBLIC_ENABLE_SOCIAL=true
NEXT_PUBLIC_ENABLE_COMMENTS=true
NEXT_PUBLIC_ENABLE_OFFLINE=true

# 开发配置 | Development
NODE_ENV=development
NEXT_PUBLIC_DEBUG=false

# ========================================
# 跨境电商内容生成平台 API 配置
# ========================================

# DeepSeek LLM (内容策划)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# HeyGen 数字人视频生成
HEYGEN_API_KEY=your_heygen_api_key_here

# AliExpress Affiliate (商品数据)
ALIEXPRESS_APP_KEY=your_aliexpress_app_key
ALIEXPRESS_APP_SECRET=your_aliexpress_app_secret

# MiniMax TTS (葡萄牙语/阿拉伯语补充)
MINIMAX_API_KEY=your_minimax_api_key_here

# CosyVoice 自托管 TTS (可选)
COSYVOICE_URL=http://localhost:8000

# LiteLLM 网关 (可选)
LITELLM_PROXY_URL=http://localhost:4000

# Langfuse 观测 (可选)
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=http://localhost:3001
